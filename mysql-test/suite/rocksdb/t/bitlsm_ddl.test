--source include/have_rocksdb.inc

# M3a-1: BITLSM_INDEX DDL surface (parse + server-layer validation).
# Non-PK-column check and CF constraints (D5) are validated in the storage
# engine (M3a-2) and are intentionally NOT covered here.

--echo # Accept: numeric + date + binary-string attributes on a non-PK secondary index
CREATE TABLE t_ok (
  id BIGINT NOT NULL,
  ln INT NOT NULL,
  shipdate DATE,
  discount DOUBLE,
  quantity INT,
  city VARBINARY(32),
  PRIMARY KEY (id, ln) COMMENT 'cfname=t_ok_cf',
  INDEX bi (shipdate, discount, quantity, city) COMMENT 'cfname=t_ok_cf' BITLSM_INDEX
) ENGINE=ROCKSDB;
SHOW CREATE TABLE t_ok;
DROP TABLE t_ok;

--echo # Reject: BITLSM_INDEX on a PRIMARY key (must be a plain secondary index)
--error ER_WRONG_ARGUMENTS
CREATE TABLE t_primary (
  id BIGINT NOT NULL,
  a INT,
  PRIMARY KEY (id) BITLSM_INDEX
) ENGINE=ROCKSDB;

--echo # Reject: BITLSM_INDEX on a UNIQUE key
--error ER_WRONG_ARGUMENTS
CREATE TABLE t_unique (
  id BIGINT NOT NULL PRIMARY KEY COMMENT 'cfname=t_unique_cf',
  a INT,
  UNIQUE KEY uk (a) BITLSM_INDEX
) ENGINE=ROCKSDB;

--echo # Reject: unsupported type (DECIMAL)
--error ER_WRONG_ARGUMENTS
CREATE TABLE t_dec (
  id BIGINT NOT NULL PRIMARY KEY COMMENT 'cfname=t_dec_cf',
  d DECIMAL(10,2),
  INDEX bi (d) BITLSM_INDEX
) ENGINE=ROCKSDB;

--echo # Reject: unsupported type (non-binary VARCHAR)
--error ER_WRONG_ARGUMENTS
CREATE TABLE t_txt (
  id BIGINT NOT NULL PRIMARY KEY COMMENT 'cfname=t_txt_cf',
  s VARCHAR(32) CHARACTER SET utf8mb4,
  INDEX bi (s) BITLSM_INDEX
) ENGINE=ROCKSDB;

--echo # Reject: PAD SPACE binary collation. utf8mb4_bin sorts by bytes but pads,
--echo # so SQL holds 'ab' = 'ab ' where SABI's memcmp does not -- a row with a
--echo # trailing space would be pruned away from a query that must match it.
--error ER_WRONG_ARGUMENTS
CREATE TABLE t_padbin (
  id BIGINT NOT NULL PRIMARY KEY COMMENT 'cfname=t_padbin_cf',
  s VARCHAR(32) COLLATE utf8mb4_bin,
  INDEX bi (s) BITLSM_INDEX
) ENGINE=ROCKSDB;

--echo # Accept: NO PAD binary collation -- the stored bytes are the value.
CREATE TABLE t_nopadbin (
  id BIGINT NOT NULL PRIMARY KEY COMMENT 'cfname=t_nopadbin_cf',
  s VARCHAR(32) COLLATE utf8mb4_0900_bin,
  INDEX bi (s) BITLSM_INDEX
) ENGINE=ROCKSDB;
DROP TABLE t_nopadbin;

--echo # Reject: fixed-width CHAR/BINARY. The row stores it space-padded, so the
--echo # bytes differ from the comparand a query supplies even under NO PAD.
--error ER_WRONG_ARGUMENTS
CREATE TABLE t_fixedchar (
  id BIGINT NOT NULL PRIMARY KEY COMMENT 'cfname=t_fixedchar_cf',
  s BINARY(16),
  INDEX bi (s) BITLSM_INDEX
) ENGINE=ROCKSDB;

--echo # ==== ORDERED / UNORDERED key-part keyword ====

--echo # Accept: ORDERED on a binary key part -- the case the keyword exists for.
CREATE TABLE t_kw_ord (
  id BIGINT NOT NULL,
  a INT, s VARBINARY(16),
  PRIMARY KEY (id) COMMENT 'cfname=t_kw_ord_cf',
  INDEX bi (a, s ORDERED) BITLSM_INDEX
) ENGINE=ROCKSDB;
DROP TABLE t_kw_ord;

--echo # Accept: UNORDERED on a numeric key part -- the mirror case. A numeric
--echo # is kRange by default; declaring it UNORDERED gives an equality-only
--echo # column a frequency-balanced dictionary instead.
CREATE TABLE t_kw_unord (
  id BIGINT NOT NULL,
  a INT, s VARBINARY(16),
  PRIMARY KEY (id) COMMENT 'cfname=t_kw_unord_cf',
  INDEX bi (a UNORDERED, s) BITLSM_INDEX
) ENGINE=ROCKSDB;
DROP TABLE t_kw_unord;

--echo # Reject: the keyword on a plain index. It selects a BITLSM bin layout
--echo # and means nothing elsewhere, so accepting and ignoring it would read as
--echo # a promise the index does not keep.
--error ER_WRONG_ARGUMENTS
CREATE TABLE t_kw_plain (
  id BIGINT NOT NULL PRIMARY KEY COMMENT 'cfname=t_kw_plain_cf',
  a INT,
  INDEX k (a ORDERED)
) ENGINE=ROCKSDB;

--echo # Reject: the keyword on a UNIQUE index.
--error ER_WRONG_ARGUMENTS
CREATE TABLE t_kw_uniq (
  id BIGINT NOT NULL PRIMARY KEY COMMENT 'cfname=t_kw_uniq_cf',
  a INT,
  UNIQUE KEY u (a UNORDERED)
) ENGINE=ROCKSDB;

--echo # ORDERED and UNORDERED stay non-reserved: still usable as identifiers.
CREATE TABLE t_kw_ident (ordered INT, unordered INT, PRIMARY KEY (ordered));
INSERT INTO t_kw_ident VALUES (1, 2);
SELECT ordered, unordered FROM t_kw_ident;
DROP TABLE t_kw_ident;

--echo # Reject: virtual generated column
--error ER_WRONG_ARGUMENTS
CREATE TABLE t_vg (
  id BIGINT NOT NULL PRIMARY KEY COMMENT 'cfname=t_vg_cf',
  a INT,
  b INT AS (a+1) VIRTUAL,
  INDEX bi (b) BITLSM_INDEX
) ENGINE=ROCKSDB;

--echo # Reject: DATETIME -- accepted by the server-layer type check today but
--echo # rejected by the engine at table open (bitlsm_derive_enc has no encoding
--echo # for it), which surfaced as HA_ERR_UNSUPPORTED instead of a DDL error.
--error ER_WRONG_ARGUMENTS
CREATE TABLE t_dtime (
  id BIGINT NOT NULL PRIMARY KEY COMMENT 'cfname=t_dtime_cf',
  ts DATETIME,
  INDEX bi (ts) BITLSM_INDEX
) ENGINE=ROCKSDB;

--echo # Reject: TIMESTAMP, same reason.
--error ER_WRONG_ARGUMENTS
CREATE TABLE t_tstamp (
  id BIGINT NOT NULL PRIMARY KEY COMMENT 'cfname=t_tstamp_cf',
  ts TIMESTAMP NULL,
  INDEX bi (ts) BITLSM_INDEX
) ENGINE=ROCKSDB;
