--source include/have_rocksdb.inc

# A BITLSM_INDEX must not advertise index order (HA_READ_ORDER / HA_READ_PREV):
# candidates come back in PK order, so an ORDER BY / GROUP BY the optimizer
# deemed satisfied by the index would stream unordered input into fragmented
# groups. udt-in-mem is skipped: it serves bitlsm reads with a PK scan.
if (`SELECT @@rocksdb_enable_udt_in_mem`) {
  --skip Test asserts the bi plan shape; udt-in-mem uses the UDT fallback path
}

CREATE TABLE t_oc (
  id BIGINT NOT NULL,
  y INT NOT NULL,
  b VARBINARY(16) NOT NULL,
  r VARBINARY(16) NOT NULL,
  v INT NOT NULL,
  PRIMARY KEY (id) COMMENT 'cfname=t_oc_cf',
  INDEX bi (y, b, r) BITLSM_INDEX
) ENGINE=ROCKSDB;

# PK order deliberately interleaves y so a stream-aggregate over PK-ordered
# candidates would fragment the y groups.
INSERT INTO t_oc VALUES
  (1,1997,'B1','E',10),(2,1992,'B1','E',20),(3,1997,'B1','E',30),
  (4,1992,'B1','E',40),(5,1995,'B1','E',50),(6,1997,'B1','E',60),
  (7,1992,'B2','E',70),(8,1995,'B1','W',80),(9,1992,'B1','E',90),
  (10,1995,'B1','E',100),(11,1997,'B2','W',110),(12,1992,'B1','E',120);
SET GLOBAL rocksdb_force_flush_memtable_now = 1;

--echo # (1) GROUP BY on leading keypart with later keyparts equality-bound —
--echo #     bi must equal the full scan.
SELECT SUM(v), y, b FROM t_oc FORCE INDEX (bi)
WHERE b='B1' AND r='E' GROUP BY y, b ORDER BY y, b;
SELECT SUM(v), y, b FROM t_oc IGNORE INDEX (bi)
WHERE b='B1' AND r='E' GROUP BY y, b ORDER BY y, b;

--echo # (2) Plan shape: the bi plan must materialize/sort (no ordered-index
--echo #     shortcut) while still using bi for pruning.
--replace_column 10 # 11 #
EXPLAIN SELECT SUM(v), y, b FROM t_oc FORCE INDEX (bi)
WHERE b='B1' AND r='E' GROUP BY y, b ORDER BY y, b;

--echo # (3) ORDER BY on the leading keypart — same contract, ordering path.
SELECT y, v FROM t_oc FORCE INDEX (bi)
WHERE b='B1' AND r='E' ORDER BY y, v;
SELECT y, v FROM t_oc IGNORE INDEX (bi)
WHERE b='B1' AND r='E' ORDER BY y, v;

--echo # (4) DESC ordering (HA_READ_PREV is equally unsupported).
SELECT y, v FROM t_oc FORCE INDEX (bi)
WHERE b='B1' AND r='E' ORDER BY y DESC, v DESC;
SELECT y, v FROM t_oc IGNORE INDEX (bi)
WHERE b='B1' AND r='E' ORDER BY y DESC, v DESC;

DROP TABLE t_oc;
