--source include/have_rocksdb.inc

# DATE pruning regression guard, runnable in release builds. bitlsm_date_read
# passes even when no DATE condition is translated (ICP filters the candidates),
# so measure the candidate set directly: rocksdb_number_multiget_keys_read counts
# one PK re-fetch per candidate, and a selective DATE predicate must keep it low.

# Under UDT the read path skips the bitmap and full-scans the PK, so there is no
# pruning to measure. bitlsm_date_read covers correctness in that combination.
--let $udt = `SELECT @@rocksdb_enable_udt_in_mem`
if ($udt) {
--skip BitLSM DATE pruning runs under non-UDT combinations only
}

# Enough rows for the SABI bins to discriminate; a handful of rows lands in one
# bin and prunes nothing even when the translation is correct.
CREATE TABLE t_dp (
  id BIGINT NOT NULL,
  d DATE,
  payload INT,
  PRIMARY KEY (id) COMMENT 'cfname=t_dp_cf',
  INDEX bi (d) BITLSM_INDEX
) ENGINE=ROCKSDB;
SET SESSION cte_max_recursion_depth = 100000;
INSERT INTO t_dp
WITH RECURSIVE s(n) AS (SELECT 0 UNION ALL SELECT n+1 FROM s WHERE n<19999)
SELECT n, DATE_ADD('2000-01-01', INTERVAL n DAY), n FROM s;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;

--echo #
--echo # A one-year window out of ~55 years of dates. The candidate count is the
--echo # multiget delta; with DATE translated it must fall far below 20000.
--disable_query_log
--disable_result_log
SELECT VARIABLE_VALUE INTO @m0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME='rocksdb_number_multiget_keys_read';
SELECT SUM(payload) INTO @s FROM t_dp FORCE INDEX(bi)
  WHERE d >= '2010-01-01' AND d < '2011-01-01';
SELECT VARIABLE_VALUE INTO @m1 FROM performance_schema.global_status
  WHERE VARIABLE_NAME='rocksdb_number_multiget_keys_read';
--let $cand = `SELECT @m1-@m0`
--enable_result_log
--enable_query_log

# Deliberately loose: this asserts that pruning happened, not a bin count. Bin
# boundaries move with rho, row count and SST layout, and echoing the count
# would pin that layout into the .result.
--let $assert_text = a selective DATE range prunes the candidate set (under 10000 of 20000)
--let $assert_cond = $cand < 10000
--source include/assert.inc

--echo #
--echo # Zero-in-date comparand (BETWEEN lower bound): the shape actually reaches
--echo # a silent comparator, verified in sql/item_cmpfunc.cc. A bare `d > '...'`
--echo # against a real DATE column resolves via Arg_comparator::set_cmp_func,
--echo # which eagerly converts a constant bound through get_date_from_const()
--echo # and raises ER_WRONG_VALUE (a HARD error) if that fails -- so that shape
--echo # cannot silently narrow, it just refuses to run. BETWEEN's bounds are
--echo # wired through Arg_comparator::set_datetime_cmp_func() instead (see
--echo # Item_func_between::resolve_type), which skips that eager conversion
--echo # entirely and leaves get_datetime_value() as the per-row value-getter --
--echo # and get_datetime_value() DOES silently swallow a parse failure and
--echo # return 0, exactly as described for get_datetime_value at
--echo # sql/item_cmpfunc.cc:1541-1544. So `d BETWEEN '2020-06-00' AND hi` has
--echo # its lower bound silently voided by the server (0 <= any real date is
--echo # always true), while the translator packs '2020-06-00' into a real okey
--echo # and prunes on it -- a genuine narrowing.
# This suite's my.cnf drops NO_ZERO_IN_DATE from sql_mode. Turn it back on so
# the server comparator takes its compare-against-0 path for '2020-06-00'; the
# translator's own parse ignores the flag, which is the disagreement under test.
SET @old_sql_mode = @@SESSION.sql_mode;
SET SESSION sql_mode = 'NO_ZERO_IN_DATE';
--let $forced = `SELECT COUNT(*) FROM t_dp FORCE INDEX(bi) WHERE d BETWEEN '2020-06-00' AND '2020-12-31'`
--let $full = `SELECT COUNT(*) FROM t_dp IGNORE INDEX(bi) WHERE d BETWEEN '2020-06-00' AND '2020-12-31'`
SET SESSION sql_mode = @old_sql_mode;
--let $assert_text = zero-in-date BETWEEN lower bound does not prune matching rows ($forced vs $full)
--let $assert_cond = $forced = $full
--source include/assert.inc

DROP TABLE t_dp;
