--source include/have_rocksdb.inc

# DATE attribute differential test.
#
# A DATE column in a BITLSM_INDEX is binned by the extractor as Enc::DATE3 --
# the 3-byte Field_newdate packing (day + month*32 + year*512, little-endian)
# read into an unsigned okey. The query translator packs a DATE comparand
# through the SAME my_date_to_binary() the field uses, so the two must agree
# byte for byte.
#
# A wrong packing does not crash and does not show up in the query-assembly
# golden test (that asserts the translated STRING, not the okey) -- it silently
# prunes away rows that should have matched. Only this differential assertion
# catches it: FORCE INDEX(bi) (bitmap-pruned) must equal IGNORE INDEX(bi)
# (full scan) for every query, in both the memtable and the flushed-SST state.
#
# No have_debug.inc here on purpose: this file must also run in release builds.

CREATE TABLE t_date (
  id BIGINT NOT NULL,
  a INT,
  d DATE,
  payload INT,
  PRIMARY KEY (id) COMMENT 'cfname=t_date_cf',
  INDEX bi (a, d) BITLSM_INDEX
) ENGINE=ROCKSDB;

# Boundary-heavy data: both leap days, a month end and the day after, a year
# boundary, the supported min/max dates, and a NULL. payload is not in bi.
INSERT INTO t_date VALUES
  (1,  1, '1000-01-01', 100),
  (2,  2, '1999-12-31', 200),
  (3,  3, '2000-01-01', 300),
  (4,  4, '2000-02-29', 400),
  (5,  5, '2020-01-31', 500),
  (6,  6, '2020-02-01', 600),
  (7,  7, '2020-06-15', 700),
  (8,  8, '2024-02-29', 800),
  (9,  9, '9999-12-31', 900),
  (10, 10, NULL,       1000);

--echo #
--echo # Routing guard: a DATE predicate must actually reach the bitlsm read
--echo # path, otherwise every differential check below passes trivially by
--echo # comparing a table scan against a table scan.
--let $k = query_get_value(EXPLAIN SELECT id FROM t_date FORCE INDEX(bi) WHERE d >= '2020-01-01', key, 1)
--let $assert_text = DATE range shape routes to the bitlsm index
--let $assert_cond = "$k" = "bi"
--source include/assert.inc

--echo #
--echo # ==== Phase 1: data in the memtable ====
--source suite/rocksdb/include/bitlsm_date_read_battery.inc

--echo #
--echo # ==== Phase 2: data flushed to an SST (SABI block present) ====
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
--source suite/rocksdb/include/bitlsm_date_read_battery.inc

DROP TABLE t_date;
