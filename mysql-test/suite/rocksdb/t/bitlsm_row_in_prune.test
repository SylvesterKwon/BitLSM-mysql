--source include/have_rocksdb.inc

# Row-constructor IN pruning signal (release-safe regression guard).
#
# If the C9 optimizer change or make_row_in_groups (rdb_bitlsm_query.cc) were
# reverted, nothing in a release build would notice: the differential
# bitlsm_index_read Q9-Q12 cases still pass (an unpruned candidate set is still
# a correct one, once ICP re-verifies it), the `EXPLAIN key=bi` routing guards
# in bitlsm_query_assembly.test pass regardless (that is the range optimizer,
# independent of ICP and of row-IN translation entirely), and the one case
# that DOES pin the assembled string down -- bitlsm_query_assembly (16) -- is
# gated on have_debug and is skipped in release builds. So the whole row-IN
# feature, plus the shared-server-code change it rests on, would be able to
# silently regress with no test failing anywhere.
#
# So, as bitlsm_date_prune.test does for DATE: measure the candidate set
# directly. rocksdb_number_multiget_keys_read counts the authoritative PK
# re-fetches, i.e. exactly one per bitmap candidate. A highly selective
# row-constructor IN over both indexed columns must drive it well below the
# table size.
#
# Needs neither have_debug nor a golden string -- it runs everywhere the engine
# actually prunes.

# Under UDT the read path skips the bitmap entirely and full-scans the PK
# (ha_rocksdb.cc, rocksdb_enable_udt_in_mem branch), so there is no pruning to
# measure. Correctness in that combination is covered by bitlsm_index_read.
--let $udt = `SELECT @@rocksdb_enable_udt_in_mem`
if ($udt) {
--skip BitLSM row-IN pruning runs under non-UDT combinations only
}

# 20000 rows, laid out as a 200 x 100 grid over (x, y) so each (x, y) pair is
# unique: x = n DIV 100 (200 distinct values), y = n MOD 100 (100 distinct
# values). A small table puts everything in one SABI bin and prunes nothing
# even when row-IN translation is working correctly.
CREATE TABLE t_rip (
  id BIGINT NOT NULL,
  x INT,
  y INT,
  payload INT,
  PRIMARY KEY (id) COMMENT 'cfname=t_rip_cf',
  INDEX bi (x, y) BITLSM_INDEX
) ENGINE=ROCKSDB;
SET SESSION cte_max_recursion_depth = 100000;
INSERT INTO t_rip
WITH RECURSIVE s(n) AS (SELECT 0 UNION ALL SELECT n+1 FROM s WHERE n<19999)
SELECT n, n DIV 100, n MOD 100, n FROM s;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;

--echo #
--echo # (x, y) IN ((50, 25), (150, 75)) distributes per column into
--echo # (x IN (50,150)) AND (y IN (25,75)) -- two of 200 x-values and two of
--echo # 100 y-values, each column independently selective. The candidate count
--echo # is the multiget delta; with row-IN translated it must fall far below
--echo # 20000. (The distributed AND also admits the two "cross" pairs
--echo # (50,75) and (150,25), which is why the exact match count is 2 but the
--echo # candidate count can be a little more than that -- ICP drops the
--echo # cross pairs before they reach the result.)
--disable_query_log
--disable_result_log
SELECT VARIABLE_VALUE INTO @m0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME='rocksdb_number_multiget_keys_read';
SELECT SUM(payload) INTO @s FROM t_rip FORCE INDEX(bi)
  WHERE (x, y) IN ((50, 25), (150, 75));
SELECT VARIABLE_VALUE INTO @m1 FROM performance_schema.global_status
  WHERE VARIABLE_NAME='rocksdb_number_multiget_keys_read';
--let $cand = `SELECT @m1-@m0`
--enable_result_log
--enable_query_log

# Deliberately loose: this asserts PRUNING HAPPENED, not a specific bin count.
# Bin boundaries move with rho, row count and SST layout, so a tight bound
# would be a maintenance trap -- the exact candidate count observed while
# writing this test was nowhere near this bound, but pinning it to that exact
# number would make the test brittle against unrelated SABI tuning changes.
# Half the table is far beyond noise for two columns this selective, and still
# fails loudly at zero pruning (candidates == 20000).
--let $assert_text = a selective row-constructor IN prunes the candidate set ($cand of 20000)
--let $assert_cond = $cand < 10000
--source include/assert.inc

DROP TABLE t_rip;
