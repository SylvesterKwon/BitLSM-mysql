--source include/have_rocksdb.inc

# Row-constructor IN pruning regression guard, runnable in release builds. The
# differential tests pass whether or not row-IN prunes, and the assembled-string
# check needs have_debug, so measure the candidate set directly with
# rocksdb_number_multiget_keys_read (one PK re-fetch per candidate).

# Under UDT the read path skips the bitmap and full-scans the PK, so there is no
# pruning to measure. bitlsm_index_read covers correctness in that combination.
--let $udt = `SELECT @@rocksdb_enable_udt_in_mem`
if ($udt) {
--skip BitLSM row-IN pruning runs under non-UDT combinations only
}

# A 200 x 100 grid over (x, y): x = n DIV 100, y = n MOD 100, so each pair is
# unique. A small table puts everything in one SABI bin and prunes nothing even
# when the translation is correct.
CREATE TABLE t_rip (
  id BIGINT NOT NULL,
  x INT,
  y INT,
  payload INT,
  PRIMARY KEY (id) COMMENT 'cfname=t_rip_cf',
  INDEX bi (x, y) BITLSM_INDEX
) ENGINE=ROCKSDB;
SET SESSION cte_max_recursion_depth = 100000;
INSERT INTO t_rip
WITH RECURSIVE s(n) AS (SELECT 0 UNION ALL SELECT n+1 FROM s WHERE n<19999)
SELECT n, n DIV 100, n MOD 100, n FROM s;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;

--echo #
--echo # (x, y) IN ((50, 25), (150, 75)) distributes per column into
--echo # (x IN (50,150)) AND (y IN (25,75)) -- two of 200 x-values and two of
--echo # 100 y-values, each column independently selective. The candidate count
--echo # is the multiget delta; with row-IN translated it must fall far below
--echo # 20000. (The distributed AND also admits the two "cross" pairs
--echo # (50,75) and (150,25), which is why the exact match count is 2 but the
--echo # candidate count can be a little more than that -- ICP drops the
--echo # cross pairs before they reach the result.)
--disable_query_log
--disable_result_log
SELECT VARIABLE_VALUE INTO @m0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME='rocksdb_number_multiget_keys_read';
SELECT SUM(payload) INTO @s FROM t_rip FORCE INDEX(bi)
  WHERE (x, y) IN ((50, 25), (150, 75));
SELECT VARIABLE_VALUE INTO @m1 FROM performance_schema.global_status
  WHERE VARIABLE_NAME='rocksdb_number_multiget_keys_read';
--let $cand = `SELECT @m1-@m0`
--enable_result_log
--enable_query_log

# Deliberately loose: this asserts that pruning happened, not a bin count. Bin
# boundaries move with rho, row count and SST layout.
--let $assert_text = a selective row-constructor IN prunes the candidate set (under 10000 of 20000)
--let $assert_cond = $cand < 10000
--source include/assert.inc

DROP TABLE t_rip;
