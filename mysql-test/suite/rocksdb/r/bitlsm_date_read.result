SELECT id, a, d, payload FROM t_date FORCE INDEX(bi) WHERE d = '2024-02-29' ORDER BY id;
id	a	d	payload
8	8	2024-02-29	800
include/assert.inc [D1 leap-day equality (d = '2024-02-29'): FORCE INDEX(bi) row set identical to full scan]
