# Mixed-type bitlsm table (INT signed, DOUBLE, VARBINARY), with negative
# values and NULLs in each index column. The bi index carries no cfname.
CREATE TABLE t_read (
id BIGINT NOT NULL,
a INT, b DOUBLE, c VARBINARY(16),
d INT,
PRIMARY KEY (id) COMMENT 'cfname=t_read_cf',
INDEX bi (a, b, c) BITLSM_INDEX
) ENGINE=ROCKSDB;
INSERT INTO t_read VALUES
(1,  -50,  -1.5, 'alpha', 100),
(2,    0,   0.0, 'beta',  200),
(3,   10,   2.5, 'gamma', 300),
(4,   10,   2.5, 'gamma', 400),
(5,   25,  99.9, 'delta', 500),
(6,  100, 100.0, 'x',     600),
(7,   10,  NULL, 'gamma', 700),
(8, NULL,   2.5, 'gamma', 800),
(9,   10,   2.5, NULL,    900),
(10,  50,  50.0, 'zeta',  NULL);
#
# The optimizer must actually route FORCE INDEX(bi) into the bitlsm read
# path (otherwise the differential checks below would pass trivially via a
# table scan on both sides). EXPLAIN shows key=bi, and because d is not in
# the index the WHERE is pushed as an index condition (ICP).
EXPLAIN SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE a >= 0 AND b < 100 AND c = 'gamma';
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t_read	NULL	range	bi	bi	14	NULL	#	#	Using index condition
Warnings:
Note	1003	/* select#1 */ select `test`.`t_read`.`id` AS `id`,`test`.`t_read`.`a` AS `a`,`test`.`t_read`.`b` AS `b`,`test`.`t_read`.`c` AS `c`,`test`.`t_read`.`d` AS `d` from `test`.`t_read` FORCE INDEX (`bi`) where ((`test`.`t_read`.`c` = 'gamma') and (`test`.`t_read`.`a` >= 0) and (`test`.`t_read`.`b` < 100))
include/assert.inc [FORCE INDEX(bi) range access is routed to the bitlsm index]
include/assert.inc [FORCE INDEX(bi) exact/ref access is routed to the bitlsm index]
#
# ==== Phase 1: data in the memtable ====
# Q1 multi-AND (a>=0 AND b<100 AND c='gamma')
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE a >= 0 AND b < 100 AND c = 'gamma' ORDER BY id;
id	a	b	c	d
3	10	2.5	gamma	300
4	10	2.5	gamma	400
include/assert.inc [Q1 multi-AND (a>=0 AND b<100 AND c='gamma'): FORCE INDEX(bi) row set identical to full scan]
# Q2 empty result (a > 1000)
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE a > 1000 ORDER BY id;
id	a	b	c	d
include/assert.inc [Q2 empty result (a > 1000): FORCE INDEX(bi) row set identical to full scan]
# Q3 all rows (a >= -2147483648 OR a IS NULL)
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE a >= -2147483648 OR a IS NULL ORDER BY id;
id	a	b	c	d
1	-50	-1.5	alpha	100
2	0	0	beta	200
3	10	2.5	gamma	300
4	10	2.5	gamma	400
5	25	99.9	delta	500
6	100	100	x	600
7	10	NULL	gamma	700
8	NULL	2.5	gamma	800
9	10	2.5	NULL	900
10	50	50	zeta	NULL
include/assert.inc [Q3 all rows (a >= -2147483648 OR a IS NULL): FORCE INDEX(bi) row set identical to full scan]
# Q4 INT equality (a = 10)
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE a = 10 ORDER BY id;
id	a	b	c	d
3	10	2.5	gamma	300
4	10	2.5	gamma	400
7	10	NULL	gamma	700
9	10	2.5	NULL	900
include/assert.inc [Q4 INT equality (a = 10): FORCE INDEX(bi) row set identical to full scan]
# Q5 boundary >= drops NULL a (a >= 10)
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE a >= 10 ORDER BY id;
id	a	b	c	d
3	10	2.5	gamma	300
4	10	2.5	gamma	400
5	25	99.9	delta	500
6	100	100	x	600
7	10	NULL	gamma	700
9	10	2.5	NULL	900
10	50	50	zeta	NULL
include/assert.inc [Q5 boundary >= drops NULL a (a >= 10): FORCE INDEX(bi) row set identical to full scan]
# Q6 IS NULL on b (b IS NULL)
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE b IS NULL ORDER BY id;
id	a	b	c	d
7	10	NULL	gamma	700
include/assert.inc [Q6 IS NULL on b (b IS NULL): FORCE INDEX(bi) row set identical to full scan]
# Q7 DOUBLE range (b >= 0.0 AND b < 50.0)
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE b >= 0.0 AND b < 50.0 ORDER BY id;
id	a	b	c	d
2	0	0	beta	200
3	10	2.5	gamma	300
4	10	2.5	gamma	400
8	NULL	2.5	gamma	800
9	10	2.5	NULL	900
include/assert.inc [Q7 DOUBLE range (b >= 0.0 AND b < 50.0): FORCE INDEX(bi) row set identical to full scan]
# Q8 VARBINARY equality (c = 'x')
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE c = 'x' ORDER BY id;
id	a	b	c	d
6	100	100	x	600
include/assert.inc [Q8 VARBINARY equality (c = 'x'): FORCE INDEX(bi) row set identical to full scan]
#
# ==== Phase 2: data flushed to an SST (SABI block present) ====
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
# Q1 multi-AND (a>=0 AND b<100 AND c='gamma')
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE a >= 0 AND b < 100 AND c = 'gamma' ORDER BY id;
id	a	b	c	d
3	10	2.5	gamma	300
4	10	2.5	gamma	400
include/assert.inc [Q1 multi-AND (a>=0 AND b<100 AND c='gamma'): FORCE INDEX(bi) row set identical to full scan]
# Q2 empty result (a > 1000)
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE a > 1000 ORDER BY id;
id	a	b	c	d
include/assert.inc [Q2 empty result (a > 1000): FORCE INDEX(bi) row set identical to full scan]
# Q3 all rows (a >= -2147483648 OR a IS NULL)
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE a >= -2147483648 OR a IS NULL ORDER BY id;
id	a	b	c	d
1	-50	-1.5	alpha	100
2	0	0	beta	200
3	10	2.5	gamma	300
4	10	2.5	gamma	400
5	25	99.9	delta	500
6	100	100	x	600
7	10	NULL	gamma	700
8	NULL	2.5	gamma	800
9	10	2.5	NULL	900
10	50	50	zeta	NULL
include/assert.inc [Q3 all rows (a >= -2147483648 OR a IS NULL): FORCE INDEX(bi) row set identical to full scan]
# Q4 INT equality (a = 10)
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE a = 10 ORDER BY id;
id	a	b	c	d
3	10	2.5	gamma	300
4	10	2.5	gamma	400
7	10	NULL	gamma	700
9	10	2.5	NULL	900
include/assert.inc [Q4 INT equality (a = 10): FORCE INDEX(bi) row set identical to full scan]
# Q5 boundary >= drops NULL a (a >= 10)
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE a >= 10 ORDER BY id;
id	a	b	c	d
3	10	2.5	gamma	300
4	10	2.5	gamma	400
5	25	99.9	delta	500
6	100	100	x	600
7	10	NULL	gamma	700
9	10	2.5	NULL	900
10	50	50	zeta	NULL
include/assert.inc [Q5 boundary >= drops NULL a (a >= 10): FORCE INDEX(bi) row set identical to full scan]
# Q6 IS NULL on b (b IS NULL)
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE b IS NULL ORDER BY id;
id	a	b	c	d
7	10	NULL	gamma	700
include/assert.inc [Q6 IS NULL on b (b IS NULL): FORCE INDEX(bi) row set identical to full scan]
# Q7 DOUBLE range (b >= 0.0 AND b < 50.0)
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE b >= 0.0 AND b < 50.0 ORDER BY id;
id	a	b	c	d
2	0	0	beta	200
3	10	2.5	gamma	300
4	10	2.5	gamma	400
8	NULL	2.5	gamma	800
9	10	2.5	NULL	900
include/assert.inc [Q7 DOUBLE range (b >= 0.0 AND b < 50.0): FORCE INDEX(bi) row set identical to full scan]
# Q8 VARBINARY equality (c = 'x')
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE c = 'x' ORDER BY id;
id	a	b	c	d
6	100	100	x	600
include/assert.inc [Q8 VARBINARY equality (c = 'x'): FORCE INDEX(bi) row set identical to full scan]
#
# ==== Phase 3: own uncommitted writes (option B: write-batch union) ====
# The committed base is now in an SST, so source (a) is the bitmap-pruned
# committed rows and source (b) is this transaction's uncommitted writes.
# Each case mutates rows inside a transaction and re-checks the same
# differential contract (FORCE INDEX(bi) == full scan) from inside the
# txn, then rolls back so the cases stay independent. A per-case row
# presence/absence assertion pins down that the write-batch union (not a
# coincidental full-scan-vs-full-scan tie) is what makes it pass.
#
# (A) in-transaction INSERT of a NEW matching row: source (a) cannot see
# it (uncommitted), so only the write-batch union (b) surfaces it.
START TRANSACTION;
INSERT INTO t_read VALUES (11, 10, 2.5, 'gamma', 1100);
# OW1 in-txn INSERT visible (a=10 AND c='gamma')
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE a = 10 AND c = 'gamma' ORDER BY id;
id	a	b	c	d
3	10	2.5	gamma	300
4	10	2.5	gamma	400
7	10	NULL	gamma	700
11	10	2.5	gamma	1100
include/assert.inc [OW1 in-txn INSERT visible (a=10 AND c='gamma'): FORCE INDEX(bi) row set identical to full scan]
include/assert.inc [OW1: in-txn inserted row 11 is visible through FORCE INDEX(bi)]
ROLLBACK;
#
# (B) in-txn UPDATE makes a committed NON-matching row match: the bitmap
# prunes it out of (a) (committed value fails the predicate), so again
# only union (b) + authoritative re-fetch surfaces it. id=5 was a=25.
START TRANSACTION;
UPDATE t_read SET a = 10 WHERE id = 5;
# OW2 in-txn UPDATE into match (a=10 AND c='delta')
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE a = 10 AND c = 'delta' ORDER BY id;
id	a	b	c	d
5	10	99.9	delta	500
include/assert.inc [OW2 in-txn UPDATE into match (a=10 AND c='delta'): FORCE INDEX(bi) row set identical to full scan]
include/assert.inc [OW2: in-txn updated row 5 now matches and is visible]
ROLLBACK;
#
# (C) in-txn UPDATE makes a committed MATCHING row stop matching: the
# bitmap still yields id=6 from (a) (committed c='x'), but the
# authoritative re-fetch + ICP drops it. id=6 was c='x'.
START TRANSACTION;
UPDATE t_read SET c = 'y' WHERE id = 6;
# OW3 in-txn UPDATE out of match (c='x')
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE c = 'x' ORDER BY id;
id	a	b	c	d
include/assert.inc [OW3 in-txn UPDATE out of match (c='x'): FORCE INDEX(bi) row set identical to full scan]
include/assert.inc [OW3: in-txn row 6 no longer matches c='x' via FORCE INDEX(bi)]
ROLLBACK;
#
# (D) in-txn DELETE of a committed matching row: the bitmap yields id=6
# from (a), but the authoritative multi_get resolves the tombstone to
# not-found and skips it.
START TRANSACTION;
DELETE FROM t_read WHERE id = 6;
# OW4 in-txn DELETE of matching row (c='x')
SELECT id, a, b, c, d FROM t_read FORCE INDEX(bi) WHERE c = 'x' ORDER BY id;
id	a	b	c	d
include/assert.inc [OW4 in-txn DELETE of matching row (c='x'): FORCE INDEX(bi) row set identical to full scan]
include/assert.inc [OW4: in-txn deleted row 6 is absent via FORCE INDEX(bi)]
ROLLBACK;
DROP TABLE t_read;
