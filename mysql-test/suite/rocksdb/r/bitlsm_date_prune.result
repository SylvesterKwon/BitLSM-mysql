CREATE TABLE t_dp (
id BIGINT NOT NULL,
d DATE,
payload INT,
PRIMARY KEY (id) COMMENT 'cfname=t_dp_cf',
INDEX bi (d) BITLSM_INDEX
) ENGINE=ROCKSDB;
SET SESSION cte_max_recursion_depth = 100000;
INSERT INTO t_dp
WITH RECURSIVE s(n) AS (SELECT 0 UNION ALL SELECT n+1 FROM s WHERE n<19999)
SELECT n, DATE_ADD('2000-01-01', INTERVAL n DAY), n FROM s;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
#
# A one-year window out of ~55 years of dates. The candidate count is the
# multiget delta; with DATE translated it must fall far below 20000.
include/assert.inc [a selective DATE range prunes the candidate set (under 10000 of 20000)]
#
# Zero-in-date comparand (BETWEEN lower bound): the shape actually reaches
# a silent comparator, verified in sql/item_cmpfunc.cc. A bare `d > '...'`
# against a real DATE column resolves via Arg_comparator::set_cmp_func,
# which eagerly converts a constant bound through get_date_from_const()
# and raises ER_WRONG_VALUE (a HARD error) if that fails -- so that shape
# cannot silently narrow, it just refuses to run. BETWEEN's bounds are
# wired through Arg_comparator::set_datetime_cmp_func() instead (see
# Item_func_between::resolve_type), which skips that eager conversion
# entirely and leaves get_datetime_value() as the per-row value-getter --
# and get_datetime_value() DOES silently swallow a parse failure and
# return 0, exactly as described for get_datetime_value at
# sql/item_cmpfunc.cc:1541-1544. So `d BETWEEN '2020-06-00' AND hi` has
# its lower bound silently voided by the server (0 <= any real date is
# always true), while the translator packs '2020-06-00' into a real okey
# and prunes on it -- a genuine narrowing.
SET @old_sql_mode = @@SESSION.sql_mode;
SET SESSION sql_mode = 'NO_ZERO_IN_DATE';
Warnings:
Warning	3135	'NO_ZERO_DATE', 'NO_ZERO_IN_DATE' and 'ERROR_FOR_DIVISION_BY_ZERO' sql modes should be used with strict mode. They will be merged with strict mode in a future release.
SET SESSION sql_mode = @old_sql_mode;
include/assert.inc [zero-in-date BETWEEN lower bound does not prune matching rows (7671 vs 7671)]
DROP TABLE t_dp;
