CREATE TABLE t_read (
id BIGINT NOT NULL,
a INT, b DOUBLE, c VARBINARY(16),
d INT,
PRIMARY KEY (id) COMMENT 'cfname=t_read_cf',
INDEX bi (a, b, c) BITLSM_INDEX
) ENGINE=ROCKSDB;
INSERT INTO t_read VALUES
(1,  -50,  -1.5, 'alpha', 100),
(2,    0,   0.0, 'beta',  200),
(3,   10,   2.5, 'gamma', 300),
(4,   10,   2.5, 'gamma', 400),
(5,   25,  99.9, 'delta', 500),
(6,  100, 100.0, 'x',     600),
(7,   10,  NULL, 'gamma', 700),
(8, NULL,   2.5, 'gamma', 800),
(9,   10,   2.5, NULL,    900),
(10,  50,  50.0, 'zeta',  NULL);
#
# ==== Phase 1: data in the memtable ====
#
# (1) THE ONE THING: no 'a' predicate, no hint -> optimizer must pick bi.
EXPLAIN SELECT id, a, b, c, d FROM t_read WHERE b < 100 AND c = 'gamma';
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t_read	NULL	range	bi	bi	0	NULL	#	#	Using index condition
Warnings:
Note	1003	/* select#1 */ select `test`.`t_read`.`id` AS `id`,`test`.`t_read`.`a` AS `a`,`test`.`t_read`.`b` AS `b`,`test`.`t_read`.`c` AS `c`,`test`.`t_read`.`d` AS `d` from `test`.`t_read` where ((`test`.`t_read`.`c` = 'gamma') and (`test`.`t_read`.`b` < 100))
include/assert.inc [auto-selected (no hint) non-leading predicate routes to bi]
# A1 non-leading AND (b<100 AND c='gamma'), auto-selected
SELECT id, a, b, c, d FROM t_read WHERE b < 100 AND c = 'gamma' ORDER BY id;
id	a	b	c	d
3	10	2.5	gamma	300
4	10	2.5	gamma	400
8	NULL	2.5	gamma	800
include/assert.inc [A1 non-leading AND (b<100 AND c='gamma'), auto-selected: auto-selected row set identical to full scan]
#
# (2) single non-leading equality (c only), no hint.
include/assert.inc [auto-selected (no hint) single non-leading equality routes to bi]
# A2 single non-leading equality (c='gamma'), auto-selected
SELECT id, a, b, c, d FROM t_read WHERE c = 'gamma' ORDER BY id;
id	a	b	c	d
3	10	2.5	gamma	300
4	10	2.5	gamma	400
7	10	NULL	gamma	700
8	NULL	2.5	gamma	800
include/assert.inc [A2 single non-leading equality (c='gamma'), auto-selected: auto-selected row set identical to full scan]
#
# (3) middle-column range only (b), no hint.
# A3 middle-column range (b >= 0.0 AND b < 50.0), auto-selected
SELECT id, a, b, c, d FROM t_read WHERE b >= 0.0 AND b < 50.0 ORDER BY id;
id	a	b	c	d
2	0	0	beta	200
3	10	2.5	gamma	300
4	10	2.5	gamma	400
8	NULL	2.5	gamma	800
9	10	2.5	NULL	900
include/assert.inc [A3 middle-column range (b >= 0.0 AND b < 50.0), auto-selected: auto-selected row set identical to full scan]
#
# (4) REGRESSION: a LEADING 'a' predicate must still work (normal path).
include/assert.inc [leading predicate (a>=10) still routes to bi]
# A4 leading predicate (a>=10), auto-selected
SELECT id, a, b, c, d FROM t_read WHERE a >= 10 ORDER BY id;
id	a	b	c	d
3	10	2.5	gamma	300
4	10	2.5	gamma	400
5	25	99.9	delta	500
6	100	100	x	600
7	10	NULL	gamma	700
9	10	2.5	NULL	900
10	50	50	zeta	NULL
include/assert.inc [A4 leading predicate (a>=10), auto-selected: auto-selected row set identical to full scan]
#
# (5) empty result via non-leading predicate.
# A5 non-leading empty (c='nope')
SELECT id, a, b, c, d FROM t_read WHERE c = 'nope' ORDER BY id;
id	a	b	c	d
include/assert.inc [A5 non-leading empty (c='nope'): auto-selected row set identical to full scan]
#
# ==== Phase 2: data flushed to an SST (SABI block present) ====
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
#
# (1) THE ONE THING: no 'a' predicate, no hint -> optimizer must pick bi.
EXPLAIN SELECT id, a, b, c, d FROM t_read WHERE b < 100 AND c = 'gamma';
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t_read	NULL	range	bi	bi	0	NULL	#	#	Using index condition
Warnings:
