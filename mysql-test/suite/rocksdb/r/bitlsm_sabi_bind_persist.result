CREATE TABLE t_sabi (
id BIGINT NOT NULL,
a INT, b INT,
d INT,
PRIMARY KEY (id) COMMENT 'cfname=t_sabi_cf',
INDEX bi (a, b) BITLSM_INDEX
) ENGINE=ROCKSDB;
SET SESSION cte_max_recursion_depth = 100000;
INSERT INTO t_sabi
WITH RECURSIVE s(n) AS (SELECT 0 UNION ALL SELECT n+1 FROM s WHERE n<19999)
SELECT n, n%1000, n%4, n FROM s;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;
SET GLOBAL rocksdb_compact_cf = 't_sabi_cf';
SET GLOBAL rocksdb_bitlsm_estimator_refresh = 1;
# restart
# Compact the data CF WITHOUT opening t_sabi first.
SET GLOBAL rocksdb_compact_cf = 't_sabi_cf';
# Now open the table and re-measure.
SELECT COUNT(*) FROM t_sabi;
COUNT(*)
20000
SET GLOBAL rocksdb_bitlsm_estimator_refresh = 1;
include/assert.inc [equality estimate survives a compaction with the table closed]
include/assert.inc [range estimate survives a compaction with the table closed]
DROP TABLE t_sabi;
